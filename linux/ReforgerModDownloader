SOURCE = Path(__file__).resolve().parent
SOURCE = SOURCE / "lib" if (SOURCE / "lib").is_dir() else SOURCE.parent
PROJECT_PAGE = "https://github.com/" + (SOURCE / "repository.txt").read_text(encoding="utf-8").splitlines()[0]
DEFAULT_HOME = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "reforger-mod-downloader"
HOME = Path(os.environ.get("RFMM_HOME", DEFAULT_HOME)).expanduser().resolve()
DATA = Path(os.environ.get("RFMM_DATA", HOME / "data")).expanduser().resolve()
ENGINE = HOME / "armar-server/ArmaReforgerServer"
ORIGIN = "rfmm://app/"
BRIDGE = r"""
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-__NONCE__'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<script nonce="__NONCE__">
(() => {
  const waiting = new Map();
  let sequence = 0;
  window.fetch = (path, options = {}) => new Promise((resolve, reject) => {
    const id = ++sequence;
    waiting.set(id, {resolve, reject});
    window.webkit.messageHandlers.request.postMessage({id, path, method:options.method || 'GET'});
  });
  window.receiveReply = (id, reply) => {
    const request = waiting.get(id);
    if (!request) return;
    waiting.delete(id);
    request.resolve(new Response(reply.body, {status:reply.status, headers:{'Content-Type':reply.type}}));
  };
})();
</script>
"""


def find_engine():
    for engine in (ENGINE, HOME / "ArmaReforgerServer"):
        if engine.is_file() and os.access(engine, os.X_OK):
            return engine
    candidates = [Path.home() / ".steam/steam", Path.home() / ".local/share/Steam",
                  Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
                  Path.home() / "snap/steam/common/.local/share/Steam"]
    candidates = list(dict.fromkeys(path.resolve() for path in candidates))
    libraries = list(candidates)
    for steam in candidates:
        try:
            config = (steam / "steamapps/libraryfolders.vdf").read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        libraries.extend(Path(p) for p in re.findall(r'"path"\s*"([^"]+)"', config) if Path(p).is_absolute())
    for library in dict.fromkeys(path.resolve() for path in libraries):
        apps = library / "steamapps"
        folders = ["Arma Reforger Server", "Arma Reforger Dedicated Server"]
        try:
            manifest = (apps / "appmanifest_1874900.acf").read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            manifest = ""
        folder = re.search(r'"installdir"\s*"([^"]+)"', manifest)
        if folder and folder[1] not in (".", "..") and Path(folder[1]).name == folder[1]:
            folders.insert(0, folder[1])
        for name in folders:
            engine = apps / "common" / name / "ArmaReforgerServer"
            if engine.is_file() and os.access(engine, os.X_OK):
                return engine
    return None


def create_log(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    log = logging.Logger(path.name)
    handler = RotatingFileHandler(path, maxBytes=2 * 1024 * 1024, backupCount=1, encoding="utf-8")
    handler.setFormatter(logging.Formatter("%(asctime)s %(message)s"))
    log.addHandler(handler)
    return log


class Worker:
    def __init__(self, log, token, read_only=False):
        DATA.mkdir(parents=True, exist_ok=True)
        self.environment = dict(os.environ, RFMM_HOME=str(HOME), RFMM_DATA=str(DATA),
                                RFMM_DESKTOP_OWNER_PID=str(os.getpid()), RFMM_DESKTOP_SESSION_TOKEN=token)
        engine = find_engine()
        if engine:
            self.environment["RFMM_ENGINE_EXE"] = str(engine)
        self.log = log
        self.command = ["pwsh", "-NoProfile", "-NonInteractive", "-File", str(SOURCE / "download-web.ps1")]
        self.options = ["-Desktop", "-ReadOnly"] if read_only else ["-Desktop"]
        self.lock = Lock()
        self.closed = False
        self.last_restart = -float("inf")
        self.start_process()

    def start_process(self):
        process = subprocess.Popen(
            self.command + self.options, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, encoding="utf-8", errors="replace", env=self.environment,
        )
        replies = Queue()
        self.process, self.replies = process, replies
        Thread(target=self.drain, args=(process.stdout, replies), daemon=True).start()
        Thread(target=self.drain, args=(process.stderr,), daemon=True).start()

    def drain(self, stream, replies=None):
        with stream:
            for line in stream:
                if replies is not None and line.startswith("RFMM "):
                    replies.put(line[5:])
                elif line.strip():
                    self.log.info(line.rstrip())
        if replies is not None:
            replies.put(None)

    def request(self, path, method="GET"):
        with self.lock:
            if self.closed:
                raise RuntimeError("The downloader is closing.")
            if self.process.poll() is not None:
                if time.monotonic() - self.last_restart < 20:
                    raise RuntimeError("The downloader stopped again. Close and reopen the app.")
                self.last_restart = time.monotonic()
                self.process.stdin.close()
                self.log.warning("Restarting the PowerShell worker after it stopped.")
                self.start_process()
            process, replies = self.process, self.replies
        process.stdin.write(json.dumps({"path": path, "method": method}) + "\n")
        process.stdin.flush()
        try:
            line = replies.get(timeout=30 if "-ReadOnly" in self.options else 90)
        except Empty:
            self.stop_process(process)
            raise RuntimeError("The downloader did not respond. Try again.")
        if line is None:
            raise RuntimeError(f"The downloader stopped. See {DATA / 'desktop.log'}.")
        return json.loads(line)

    def stop_downloads(self):
        result = subprocess.run(self.command + ["-DesktopStop"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding="utf-8", errors="replace", env=self.environment, timeout=25)
        if result.stdout.strip():
            self.log.info(result.stdout.rstrip())
        result.check_returncode()

    def close(self):
        with self.lock:
            self.closed = True
            process = self.process
        self.stop_process(process)

    @staticmethod
    def stop_process(process):
        try:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=3)
        finally:
            process.stdin.close()


class Downloader(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="net.reforger.moddownloader")
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.status_pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.window = None
        self.worker = None
        self.status_worker = None
        self.desktop_log = None
        self.installing = False
        self.setup_cancelled = Event()
        self.setup_lock = Lock()
        self.setup_process = None
        self.stopping_downloads = False
        self.view = None

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        self.window = Gtk.ApplicationWindow(application=self, title="Arma Reforger Mod Downloader")
        self.window.set_default_size(1024, 740)
        self.window.connect("delete-event", self.close_window)
        if not shutil.which("pwsh"):
            self.show_error("PowerShell 7 is required. Install pwsh and reopen the downloader.")
        elif find_engine():
            self.open_dashboard()
        else:
            self.show_setup()
        self.window.show_all()

    def close_window(self, _window, _event):
        if self.installing:
            self.cancel_install()
            return False
        if self.stopping_downloads:
            return True
        if not self.worker:
            return False
        self.stopping_downloads = True
        self.window.set_sensitive(False)
        Thread(target=self.stop_downloads_and_close, daemon=True).start()
        return True

    def stop_downloads_and_close(self):
        error = None
        try:
            self.worker.close()
            if self.status_worker:
                self.status_worker.close()
            self.worker.stop_downloads()
        except (OSError, subprocess.SubprocessError) as problem:
            self.desktop_log.error("Could not confirm the engine stopped: %s", problem)
            error = problem
        GLib.idle_add(self.finish_close, error)

    def finish_close(self, error):
        if error:
            dialog = Gtk.MessageDialog(
                transient_for=self.window, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK, text="The download engine may still be running. See desktop.log for details.",
            )
            dialog.run()
            dialog.destroy()
        self.window.destroy()
        return False

    def show_error(self, text):
        for child in self.window.get_children():
            self.window.remove(child)
        label = Gtk.Label(label=text)
        label.set_line_wrap(True)
        label.set_margin_start(24)
        label.set_margin_end(24)
        self.window.add(label)
        self.window.show_all()

    def show_setup(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=28)
        title = Gtk.Label(label="Set up the download engine", xalign=0)
        panel.pack_start(title, False, False, 0)
        panel.pack_start(Gtk.Label(
            label=f"SteamCMD installs the free dedicated server here. Allow about 20 GB.\n{HOME}",
            xalign=0, wrap=True,
        ), False, False, 0)
        self.install = Gtk.Button(label="Install engine", halign=Gtk.Align.START)
        self.install.connect("clicked", self.start_setup)
        panel.pack_start(self.install, False, False, 0)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.progress.set_text("Ready to install")
        panel.pack_start(self.progress, False, False, 0)
        self.window.add(panel)

    def start_setup(self, _button):
        if find_engine():
            self.open_dashboard()
            return
        steamcmd = shutil.which("steamcmd")
        if not steamcmd and Path("/usr/games/steamcmd").is_file():
            steamcmd = "/usr/games/steamcmd"
        if not steamcmd:
            self.setup_error("Install SteamCMD from your Linux distribution, then try again.")
            return
        self.installing = True
        self.setup_cancelled.clear()
        self.progress.set_text("Connecting to Steam…")
        self.progress.set_fraction(0)
        self.install.set_sensitive(False)
        self.pool.submit(self.install_engine, steamcmd).add_done_callback(
            lambda future: GLib.idle_add(self.setup_finished, future)
        )

    def setup_error(self, message):
        dialog = Gtk.MessageDialog(transient_for=self.window, modal=True, message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.CLOSE, text=message)
        dialog.run()
        dialog.destroy()

    def update_progress(self, label, percent):
        self.progress.set_text(label)
        if percent is None:
            self.progress.pulse()
        else:
            self.progress.set_fraction(min(1, max(0, percent / 100)))
        return False

    def install_engine(self, steamcmd):
        ENGINE.parent.mkdir(parents=True, exist_ok=True)
        if shutil.disk_usage(ENGINE.parent).free < 20 * 1024**3:
            raise RuntimeError(f"Free 20 GB on the drive containing {ENGINE.parent}, then try again.")
        DATA.mkdir(parents=True, exist_ok=True)
        log_path = DATA / "setup.log"
        command = [steamcmd, "+force_install_dir", str(ENGINE.parent), "+login", "anonymous",
                   "+app_info_update", "1", "+app_update", "1874900", "validate", "+quit"]
        log = create_log(log_path)
        with closing(log.handlers[0]):
            for attempt in range(1, 4):
                with self.setup_lock:
                    if self.setup_cancelled.is_set():
                        return
                    process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                               stderr=subprocess.STDOUT, text=True, errors="replace",
                                               start_new_session=True)
                    self.setup_process = process
                try:
                    with process:
                        self.read_setup_progress(process.stdout, log)
                        code = process.wait()
                finally:
                    with self.setup_lock:
                        self.setup_process = None
                if self.setup_cancelled.is_set() or (ENGINE.is_file() and os.access(ENGINE, os.X_OK)):
                    return
                log.warning("SteamCMD attempt %s exited %s; engine not installed.", attempt, code)
                if attempt < 3:
                    GLib.idle_add(self.update_progress, "Steam setup is retrying…", None)
        raise RuntimeError(f"Engine setup failed. Details are in {log_path}.")

    def read_setup_progress(self, output, log):
        for line in output:
            log.info(line.rstrip())
            match = re.search(r"Update state \([^)]+\)\s+([^,]+),\s*progress:\s*([0-9.]+)", line)
            if match:
                phase = "Downloading engine" if "download" in match[1].lower() else "Preparing engine"
                percent = float(match[2])
                GLib.idle_add(self.update_progress, f"{phase} · {percent:.0f}%", percent)

    def cancel_install(self):
        self.setup_cancelled.set()
        with self.setup_lock:
            process = self.setup_process
        if process is None or process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                return
        except ProcessLookupError:
            return

    def setup_finished(self, future):
        self.installing = False
        if self.setup_cancelled.is_set():
            return False
        try:
            future.result()
        except Exception as error:
            self.progress.set_text("Setup stopped")
            self.setup_error(str(error))
            self.install.set_sensitive(True)
            return
        self.open_dashboard()
        self.window.show_all()

    def open_dashboard(self):
        for child in self.window.get_children():
            self.window.remove(child)
        try:
            self.desktop_log = create_log(DATA / "desktop.log")
            token = secrets.token_hex(16)
            self.worker = Worker(self.desktop_log, token)
        except OSError as error:
            self.show_error(str(error))
            return
        try:
            self.status_worker = Worker(self.desktop_log, token, read_only=True)
        except OSError as error:
            self.desktop_log.warning("Could not start the read-only status worker: %s", error)
        context = WebKit2.WebContext.new_ephemeral()
        context.get_security_manager().register_uri_scheme_as_secure("rfmm")
        context.register_uri_scheme("rfmm", self.serve_page)
        manager = WebKit2.UserContentManager()
        manager.register_script_message_handler("request")
        manager.connect("script-message-received::request", self.handle_request)
        self.view = WebKit2.WebView(web_context=context, user_content_manager=manager)
        settings = self.view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.NEVER)
        self.view.connect("decide-policy", self.navigation_policy)
        self.window.add(self.view)
        self.view.show()
        self.view.load_uri(ORIGIN)

    def navigation_policy(self, _view, decision, kind):
        if kind in (WebKit2.PolicyDecisionType.NAVIGATION_ACTION, WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION):
            action = decision.get_navigation_action()
            uri = action.get_request().get_uri()
            if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION and uri.split("#", 1)[0] == ORIGIN:
                return False
            decision.ignore()
            if action.is_user_gesture() and uri == PROJECT_PAGE:
                Gio.AppInfo.launch_default_for_uri(uri, None)
            return True
        return False

    def serve_page(self, request):
        if request.get_uri() != ORIGIN:
            request.finish(Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(b"")), 0, "text/plain")
            return
        self.pool.submit(self.worker.request, "/").add_done_callback(
            lambda future: GLib.idle_add(self.finish_page, request, future)
        )

    def finish_page(self, request, future):
        try:
            reply = future.result()
            if reply["status"] != 200:
                raise RuntimeError(reply["body"])
            nonce = reply.get("nonce", "")
            if not re.fullmatch(r"[0-9a-f]{32}", nonce or ""):
                raise RuntimeError("Dashboard script policy is missing.")
            bridge = BRIDGE.replace("__NONCE__", nonce)
            html = reply["body"].replace("</head>", bridge + "</head>", 1).encode("utf-8")
        except Exception as error:
            html = GLib.markup_escape_text(str(error)).encode("utf-8")
        request.finish(Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(html)), len(html), "text/html")

    def handle_request(self, _manager, message):
        uri = self.view.get_uri()
        if self.stopping_downloads or not uri or uri.split("#", 1)[0] != ORIGIN:
            return
        try:
            args = json.loads(message.get_js_value().to_json(0))
            path, method, identity = args["path"], args["method"], args["id"]
            if type(identity) is not int or not 1 <= identity <= 2**53 - 1:
                return
            if method not in ("GET", "POST") or not isinstance(path, str) or not path.startswith("/") or path.startswith("//"):
                return
            route = urlsplit(path)
        except (KeyError, TypeError, ValueError):
            return
        if route.netloc or "\\" in path or any(ord(ch) < 32 for ch in path):
            return
        use_status = self.status_worker and method == "GET" and route.path in ("/status", "/completed")
        pool, worker = (self.status_pool, self.status_worker) if use_status else (self.pool, self.worker)
        pool.submit(worker.request, path, method).add_done_callback(
            lambda future: GLib.idle_add(self.deliver_reply, identity, future)
        )

    def deliver_reply(self, identity, future):
        if self.stopping_downloads:
            return False
        try:
            reply = future.result()
        except Exception as error:
            reply = {"status": 503, "type": "application/json", "body": json.dumps({"error": str(error)})}
        self.view.evaluate_javascript(f"window.receiveReply({identity}, {json.dumps(reply)})",
                                      -1, None, ORIGIN, None, None, None)

    def do_shutdown(self):
        if self.installing:
            self.cancel_install()
        for worker in (self.worker, self.status_worker):
            if worker:
                worker.close()
        for pool in (self.pool, self.status_pool):
            pool.shutdown(wait=False, cancel_futures=True)
        if self.desktop_log:
            for handler in self.desktop_log.handlers:
                handler.close()
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    sys.exit(Downloader().run(sys.argv))
